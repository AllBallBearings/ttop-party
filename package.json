{
  "name": "tabletop-ar-suite",
  "version": "1.0.0",
  "description": "QR-anchored AR tabletop multiplayer mobile web mini-game suite",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "npm run test:games && npm run test:ar",
    "test:games": "node --test test/games/*.test.mjs",
    "test:ar": "node --test test/plinth/unit.test.mjs test/plinth/tracking.test.mjs",
    "test:ar:browser": "node --test test/plinth/browser.test.mjs",
    "bench:ar": "node test/plinth/sequence.mjs all"
  },
  "keywords": [
    "ar",
    "tabletop",
    "multiplayer",
    "mobile",
    "web",
    "threejs",
    "qr"
  ],
  "license": "MIT",
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "three": "^0.183.0",
    "ws": "^8.19.0"
  }
}
